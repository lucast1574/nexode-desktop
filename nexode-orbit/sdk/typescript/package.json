{
  "name": "@nexode/agent-sdk",
  "version": "1.2.0",
  "description": "TypeScript SDK for the nexode harness API (protocol v1)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test --experimental-strip-types test/*.test.ts",
    "check": "npm run typecheck && npm run test",
    "clean": "rm -rf dist",
    "prepack": "npm run clean && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  },
  "keywords": [
    "nexode",
    "agent",
    "sdk",
    "llm",
    "coding-agent",
    "harness-api"
  ],
  "homepage": "https://nexode.app",
  "author": "Nexode contributors",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "ajv": "^8.20.0"
  },
  "optionalDependencies": {
    "@nexode/agent-darwin-arm64": "1.2.0",
    "@nexode/agent-darwin-x64": "1.2.0",
    "@nexode/agent-linux-arm64": "1.2.0",
    "@nexode/agent-linux-x64": "1.2.0",
    "@nexode/agent-win32-arm64": "1.2.0",
    "@nexode/agent-win32-x64": "1.2.0"
  },
  "private": true
}
