[Unit]
Description=nexode pairing code service
After=network.target

[Service]
EnvironmentFile=/etc/nexode-pair.env
ExecStart=/usr/local/bin/orbit-dev pair-service --host ${NEXODE_GATEWAY_HOST} --bind ${NEXODE_PAIR_BIND} --run-as ${NEXODE_PAIR_USER}
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
